# ============================================================
# ElliraAI — Environment Variables Template
# ============================================================
# Copy this file to the appropriate location and fill in values:
#   Server: cp .env.example Server/.env
#   Client: cp .env.example Client/.env (only VITE_ vars needed)
# ============================================================

# ── Server Configuration ──
PORT=8000
NODE_ENV=development

