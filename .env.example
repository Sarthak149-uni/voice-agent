CASHFREE_SECRET_KEY=
# SANDBOX for testing, PRODUCTION for live
CASHFREE_ENVIRONMENT=SANDBOX

# ── Gemini API Key Encryption ──
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
