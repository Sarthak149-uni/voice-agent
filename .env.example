# Option 1: Service account JSON string (recommended for production)
#   Set FIREBASE_SERVICE_ACCOUNT_KEY to the full JSON content of your
#   Firebase service account key file (download from Firebase Console →
#   Project Settings → Service Accounts → Generate New Private Key)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"elliraai",...}

